{
  "name": "venice-ai",
  "displayName": "Venice AI",
  "description": "AI-powered code completions and chat using Venice AI",
  "version": "0.1.0",
  "publisher": "venice-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wiradjuri/venice-ai-vscode.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "venice.setApiKey",
        "title": "Venice: Set API Key"
      },
      {
        "command": "venice.openChat",
        "title": "Venice: Open Chat"
      },
      {
        "command": "venice.toggleCompletions",
        "title": "Venice: Toggle Inline Completions"
      },
      {
        "command": "venice.clearChat",
        "title": "Venice: Clear Chat History"
      },
      {
        "command": "venice.rebuildIndex",
        "title": "Venice: Rebuild Index"
      },
      {
        "command": "venice.showIndexStatus",
        "title": "Venice: Show Index Status"
      },
      {
        "command": "venice.toggleWorkspaceEnabled",
        "title": "Venice: Toggle Enabled for This Workspace"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "venice.chatView",
          "name": "Venice AI Chat"
        }
      ]
    },
    "configuration": {
      "title": "Venice AI",
      "properties": {
        "venice.model": {
          "type": "string",
          "default": "olafangensan-glm-4.7-flash-heretic",
          "description": "The Venice AI model to use"
        },
        "venice.completionsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline code completions"
        },
        "venice.completionDebounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce delay for completions in milliseconds"
        },
        "venice.maxContextLines": {
          "type": "number",
          "default": 50,
          "description": "Maximum lines of context to send for completions"
        },
        "venice.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable Venice AI for this workspace. Disable to stop all network calls (chat and completions) without removing the API key. Use \"Venice: Toggle Enabled for This Workspace\" to change this quickly."
        },
        "venice.maxIndexSizeMB": {
          "type": "number",
          "default": 200,
          "description": "Maximum on-disk size (MB) of the local embedding index. The background indexing sweep stops early once this is reached; already-indexed files (open editors and recently modified files are prioritized) remain searchable."
        }
      }
    },
    "keybindings": [
      {
        "command": "venice.openChat",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.2",
    "ignore": "^7.0.6",
    "shell-quote": "^1.10.0"
  }
}
